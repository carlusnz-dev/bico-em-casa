# Copie este arquivo para .env e ajuste os valores.
#   cp .env.exemplo .env
# O .env e ignorado pelo git. Nenhum segredo real entra no repositorio (RNF004).

# --- PostgreSQL 18 ---
POSTGRES_DB=bicoemcasa
POSTGRES_USER=bicoemcasa
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# --- MinIO (armazenamento S3) ---
# MINIO_ROOT_PASSWORD precisa ter no minimo 8 caracteres.
MINIO_ROOT_USER=bicoemcasa
MINIO_ROOT_PASSWORD=troque-esta-senha
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
