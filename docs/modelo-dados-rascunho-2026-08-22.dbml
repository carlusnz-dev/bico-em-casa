// =============================================================================
// Bico em Casa — Modelo de Dados · RASCUNHO
//
// Autor: Carlos Antunes · Data: 2026-08-22 · Ferramenta: dbdiagram.io
// Screenshot: docs/schema bico em casa.png
//
// -----------------------------------------------------------------------------
// ISTO NAO E A FONTE DA VERDADE.
// A fonte da verdade continua sendo docs/modelo-dados.dbml (18 tabelas).
// Este arquivo preserva, sem alteracao, a revisao feita no dbdiagram para que a
// discussao nao se perca e para que as boas ideias sejam incorporadas depois.
// -----------------------------------------------------------------------------
//
// O QUE ESTA VERSAO TROUXE DE BOM (a incorporar no modelo canonico):
//   usuario.ultimo_login      distingue conta suspensa de conta inativa por
//                             desuso — e a diferenca que o RF021 precisa
//   denuncia.contratacao_id   ancora a denuncia a um trabalho concreto, dando
//                             ao admin o historico do servico na hora de julgar
//   portfolio.slug_url        URL publica amigavel (falta UNIQUE)
//
// O QUE ESTA PENDENTE NESTA VERSAO (o autor atualiza depois):
//   controle de login   faltam refresh_token e token_recuperacao
//                       -> RF001 (logout, recuperacao), RNF019, RNF021
//   auditoria           falta log_acoes
//                       -> RF022 (motivo da acao), RNF022
//   endereco            falta a tabela com latitude/longitude
//                       -> RF013 (distancia em km), RNF018, filtro do RF004
//
// DEFEITOS JA MAPEADOS (ver o relatorio da sessao de 2026-08-22):
//   bloqueante  contratacao.cancelamento_perfil_id NOT NULL torna impossivel
//               criar uma contratacao — ninguem cancelou nada ainda
//   bloqueante  disponibilidade.perfil_id UNIQUE limita o profissional a um
//               unico dia da semana, contra o RF005
//   bloqueante  contratacao nao tem descricao — o RF014 pede que o cliente
//               descreva o servico desejado
//   grave       STATUS_SERVICO nao tem RECUSADA (RF012, RF017)
//   grave       os enums tipo_alvo_denuncia e status_denuncia estao declarados
//               mas nao sao usados por nenhuma coluna — RF020 fica sem fila de
//               moderacao e so permite denunciar perfil
//   grave       nenhuma Ref tem politica de exclusao, o que anula a §6 do
//               modelo-dados.md e a estrategia de anonimizacao do RNF015
//   convencao   nomes sem prefixo tb_ e no singular, PKs bigint misturadas com
//               uuid, timestamp em vez de timestamptz, dinheiro em int
//
// =============================================================================

// #region
table usuario {
  id bigint [primary key]
  nome varchar(255)
  email varchar(255) [unique]
  email_verificacao bool [not null, default: false]
  hash_senha varchar(255) [not null]
  cpf varchar(255)
  ativo bool [default: true]
  ultimo_login timestamp
  criado_em timestamp
  atualizado_em timestamp

  indexes {
    email [unique, name: 'uq_usuarios_email']
    cpf [unique, name: 'uq_usuarios_cpf']
    ativo [name: 'idx_usuarios_ativo']
  }
}

table perfil {
  id bigint [primary key]
  usuario_id bigint [not null]
  nome_usuario varchar(255) [unique]
  email varchar(255)
  telefone varchar(30)
  localizacao varchar(100)
  tipo TIPO_PERFIL [default: TIPO_PERFIL.CLIENTE]
  foto_url varchar(500)
  bio text
  criado_em timestamp
  atualizado_em timestamp

  indexes {
    (usuario_id, tipo) [unique, name: 'uq_perfis_usuario_tipo']
    usuario_id [name: 'idx_perfis_usuario_id']
    tipo [name: 'idx_perfis_tipo']
  }
}

table disponibilidade {
  id uuid [primary key]
  perfil_id bigint [unique]
  dias_semana smallint [not null, check: `ck_disponibilidades_dias: 0=domingo .. 6=sabado`]
  hora_inicio time
  hora_final time [check: `ck_disponibilidade_intervalo: hora_final > hora_inicio`]
  criado_em timestamp
  atualizado_em timestamp

  indexes {
    (perfil_id, dias_semana) [name: 'idx_disponibilidades_perfil_dia']
  }
}
// #endregion

// #region portfolio e galeria
table portfolio {
  id bigint [primary key]
  perfil_id bigint [unique]
  titulo varchar(120)
  descricao text
  slug_url varchar(120)
  foto_capa_url varchar(500)
  criado_em timestamp
  atualizado_em timestamp

  indexes {
    perfil_id [unique, name: 'uq_portfolios_perfil_id']
  }
}

table portfolio_foto {
  id uuid [primary key]
  portfolio_id bigint [not null]
  url varchar(500) [not null]
  legenda varchar(120)
  ordem int [not null, default: 0]
  criado_em timestamp

  indexes {
    (portfolio_id, ordem) [name: 'idx_portfolio_fotos_portfolio_ordem']
  }
}
// #endregion

// #region servicos e contratacoes
table servico {
  id uuid [primary key]
  titulo varchar(50)
  descricao varchar(155)
  perfil_id bigint [not null]
  preco_previo int [not null, check: `ck_preco_vazio: preco_previo >= 0`]
  ativo bool [default: true]
  criado_em timestamp
  atualizado_em timestamp

  indexes {
    perfil_id [name: 'idx_servicos_perfil']
    ativo [name: 'idx_servicos_ativo']
  }
}

table tag {
  id uuid [primary key]
  nome varchar(40) [unique, check: `ck_tags_vazio: lenght(trim(nome)) > 0`]
  slug varchar(50)
  criado_em timestamp
  atualizado_em timestamp

  indexes {
    nome [unique, name: 'uq_tags_nome']
    slug [unique, name: 'uq_tags_slug']
  }
}

// servicos <> tags

table servicos_tags {
  servico_id uuid [not null]
  tag_id uuid [not null]

  indexes {
    (servico_id, tag_id) [pk]
    tag_id [name: 'idx_servicos_tags_tag_id']
  }
}

table contratacao {
  id uuid [primary key]
  titulo varchar(100) [not null]
  servico_id uuid [not null]
  profissional_id bigint [not null]
  cliente_id bigint [not null]
  valor_orcado decimal(10,2)
  valor_final decimal(10,2)
  distancia_km decimal(6,2)
  motivo_cancelamento text
  cancelamento_perfil_id bigint [not null]
  status STATUS_SERVICO [default: STATUS_SERVICO.solicitada]
  criado_em timestamp
  concluido_em timestamp
  atualizado_em timestamp

  indexes {
    cliente_id [name: 'idx_contratacoes_cliente']
    profissional_id [name: 'idx_contratacoes_profissional']
    (cliente_id, criado_em) [name: 'idx_contratacoes_cliente_criado_em']
  }
}

table contratacao_historico {
  id uuid [primary key]
  contratacao_id uuid [not null]
  status_anterior STATUS_SERVICO
  status_novo STATUS_SERVICO
  alterado_perfil_id bigint [not null]
  observacao varchar(255)
  criado_em timestamp

  indexes {
    (contratacao_id, criado_em) [name: 'idx_contratacao_status_historico']
  }
}

table contratacao_anexos {
  id uuid [primary key]
  contratacao_id uuid [not null]
  url varchar(500)
  nome_arquivo varchar(200)
  tamanho_bytes bigint
  tipo_conteudo varchar(80) [note: 'RNF017']
  criado_em timestamp

  indexes {
    contratacao_id [name: 'idx_contratacoes_anexos_contratacao_id']
  }
}

table denuncia {
  id uuid [primary key]
  titulo varchar(100) [not null]
  descricao text
  autor_id bigint [not null]
  culpado_id bigint [not null]
  contratacao_id uuid [unique]
  fotos jsonb
  criado_em timestamp
  analizado_em timestamp
}
// #endregion

table notificacao {
  id uuid [primary key]
  titulo varchar(120)
  tipo varchar(60)
  destinatario_perfil_id bigint [not null]
  mensagem varchar(120)
  alvo_tipo varchar(40)
  lido_em timestamp
  criado_em timestamp

  indexes {
    (destinatario_perfil_id, lido_em) [name: 'idx_notificacoes_destinatario_lida']
  }
}

// #region avaliacoes
table avaliacao {
  id uuid [primary key]
  contratacao_id uuid [unique]
  autor_id bigint [not null]
  avaliado_id bigint [not null]
  nota smallint [check: `ck_avaliacoes_nota_valida: nota BETWEEN 1 AND 5`]
  comentario text
  criado_em timestamp
  atualizado_em timestamp

  indexes {
    contratacao_id [unique, name: 'uq_avaliacoes_contratacao_id']
    avaliado_id [name: 'idx_avaliacoes_avaliado_id']
    (avaliado_id, nota) [name: 'idx_avaliacoes_avaliado_nota']
  }
}

// Enums
enum TIPO_PERFIL {
  CLIENTE
  PROFISSIONAL
  ADMIN
}

enum STATUS_SERVICO {
  solicitada
  orcada
  aceita
  em_andamento
  concluida
  cancelada
}

enum TIPO_ALVO_DENUNICA {
  servico
  perfil
  avaliacao
}

enum status_denuncia {
  pendente
  procedente
  improcedente
}

// perfil
Ref: disponibilidade.perfil_id - perfil.id
Ref: perfil.usuario_id > usuario.id
// serviços
Ref: servico.perfil_id > perfil.id
// contratacao
Ref: contratacao.servico_id > servico.id
Ref: contratacao.cliente_id > perfil.id
Ref: contratacao.profissional_id > perfil.id
Ref: contratacao_historico.contratacao_id > contratacao.id
Ref: contratacao.cancelamento_perfil_id > perfil.id
Ref: contratacao_anexos.contratacao_id > contratacao.id
// denuncias e avaliacoes
Ref: avaliacao.contratacao_id - contratacao.id
Ref: avaliacao.autor_id > perfil.id
Ref: avaliacao.avaliado_id > perfil.id
Ref: denuncia.autor_id > perfil.id
Ref: denuncia.culpado_id > perfil.id
Ref: denuncia.contratacao_id - contratacao.id
// portfolio
Ref: portfolio.perfil_id - perfil.id
Ref: portfolio_foto.portfolio_id > portfolio.id
// tag
Ref: servicos_tags.tag_id > tag.id
Ref: servicos_tags.servico_id > servico.id
// notificacao
Ref: notificacao.destinatario_perfil_id > perfil.id
