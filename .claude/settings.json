{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "env": {
    "BEC_DOC_FONTE_VERDADE": "docs/arquitetura-sistema.json",
    "BEC_DOC_ESPELHO": "docs/design-sistema.md"
  },

  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(jq *)",
      "Bash(mvn test:*)",
      "Bash(mvn verify:*)",
      "Bash(mvn -B *)",
      "Bash(npm run *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/application-prod.yml)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)"
    ]
  },

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/paridade-docs.sh\"",
            "timeout": 10,
            "statusMessage": "Verificando paridade da documentacao..."
          }
        ]
      }
    ]
  }
}
